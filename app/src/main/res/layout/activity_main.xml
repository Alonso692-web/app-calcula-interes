<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="@string/etiqueta_nombre_app"
        android:textColor="@color/primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/etiqueta_boton_limpiar"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_clear"
            app:iconTint="@color/green_500"
            app:strokeColor="@color/green_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/etiqueta_boton_calcular"
            app:backgroundTint="@color/green_500"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_calculate"
            app:iconTint="@android:color/white" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/buttonLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/inputCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- CAMPO CANTIDAD INICIAL -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/amountInputLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:errorIconDrawable="@drawable/ic_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:startIconDrawable="@drawable/ic_money"
                        app:startIconTint="@color/green_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCantidadInicial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/etiqueta_cantidad_inicial"
                            android:inputType="numberDecimal"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- TEXTVIEW PARA EL ERROR DE CANTIDAD -->
                    <TextView
                        android:id="@+id/tvAmountError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="Ingrese un monto válido"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/amountInputLayout"
                        tools:visibility="visible" />

                    <!-- CAMPO TASA DE INTERÉS -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/rateInputLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:errorIconDrawable="@drawable/ic_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAmountError"
                        app:startIconDrawable="@drawable/ic_percent"
                        app:startIconTint="@color/green_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTasaInteres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/etiqueta_tasa_de_interes"
                            android:inputType="numberDecimal"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- TEXTVIEW PARA EL ERROR DE TASA -->
                    <TextView
                        android:id="@+id/tvRateError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="Ingrese una tasa válida"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rateInputLayout"
                        tools:visibility="visible" />

                    <!-- CAMPO PLAZO -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/daysInputLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:errorIconDrawable="@drawable/ic_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvRateError"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:startIconTint="@color/green_500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPlazo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/etiqueta_plazo"
                            android:inputType="number"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- TEXTVIEW PARA EL ERROR DE PLAZO -->
                    <TextView
                        android:id="@+id/tvDaysError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="Ingrese un plazo válido"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/daysInputLayout"
                        tools:visibility="visible" />

                    <RadioGroup
                        android:id="@+id/interestTypeGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDaysError">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbTipoInteresSimple"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/etiqueta_checkbox_interes_simple"
                            app:buttonTint="@color/green_500" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbTipoInteresCompuesto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/etiqueta_checkbox_interes_compuesto"
                            app:buttonTint="@color/green_500" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/frequencyInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/interestTypeGroup">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/frequencySpinner"
                            style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="Frecuencia de capitalización"
                            android:inputType="none"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="16dp" />

            <LinearLayout
                android:id="@+id/resultLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMontoFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="$0.00"
                    android:textColor="@color/green_500"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGanancia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ganancia: $0.00"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/etiqueta_movimientos"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_history" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>